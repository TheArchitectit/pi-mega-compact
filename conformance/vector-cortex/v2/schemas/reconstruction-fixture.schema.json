{"$schema":"https://json-schema.org/draft-07/schema#","description":"Common structure every VC4C reconstruction fixture validates against. `input.scenario` names the closure / assembly / validation condition the acceptance test executes against the REAL reconstruct module (src/vector-cortex/reconstruct/{closure,assemble,validate}.js); `expected` gives the exact verdict (ok) or the failure code (REC_SOURCE_UNAVAILABLE / REC_ANCHOR_MISSING / REC_TOOL_PAIR_SPLIT / REC_DIGEST_MISMATCH / REC_CONTRADICTION_UNRESOLVED / REC_SPAN_OVERLAP). Graphs and shards are described declaratively by name and materialized by the test, so no byte payload is embedded.","properties":{"assertion":{"type":"string"},"expected":{"properties":{"assemblySortedBySource":{"type":"boolean"},"bySource":{"properties":{"exact":{"type":"integer"},"residual":{"type":"integer"},"semantic":{"type":"integer"}},"type":"object"},"byteTotal":{"type":"integer"},"closureReachedFixedPoint":{"type":"boolean"},"code":{"enum":["REC_SOURCE_UNAVAILABLE","REC_ANCHOR_MISSING","REC_TOOL_PAIR_SPLIT","REC_DIGEST_MISMATCH","REC_CONTRADICTION_UNRESOLVED","REC_SPAN_OVERLAP","CLO_CONTRADICTION_UNRESOLVED","CLO_UNKNOWN_SEED","CLO_MISSING_NODE"],"type":"string"},"digestIsConcatenation":{"type":"boolean"},"emits":{"enum":["vector_cortex_reconstruction_validated","vector_cortex_closure_rejected"],"type":"string"},"mandatoryTokenEstimate":{"type":"integer"},"ok":{"type":"boolean"},"protectedSpanCount":{"type":"integer"},"removedContradictions":{"items":{"type":"string"},"type":"array"},"selected":{"items":{"type":"string"},"type":"array"},"selectedCount":{"type":"integer"},"semanticExcluded":{"type":"boolean"},"semanticLossStated":{"type":"boolean"},"spanCount":{"type":"integer"},"summaryOpaque":{"type":"boolean"},"unresolved":{"items":{"type":"string"},"type":"array"}},"required":["ok"],"type":"object"},"id":{"type":"string"},"input":{"properties":{"closureOk":{"type":"boolean"},"eraseShard":{"type":"string"},"forceModeB":{"type":"boolean"},"graph":{"type":"string"},"mode":{"enum":["A","B","C"],"type":"string"},"scenario":{"type":"string"},"seeds":{"items":{"type":"string"},"type":"array"},"shards":{"type":"string"}},"required":["scenario"],"type":"object"},"kind":{"enum":["reconstruction"],"type":"string"},"producer":{"type":"string"}},"required":["id","producer","assertion","kind","expected","input"],"title":"VC4C reconstruction fidelity fixture envelope","type":"object"}
