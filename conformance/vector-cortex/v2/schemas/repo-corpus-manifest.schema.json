{"$schema":"https://json-schema.org/draft-07/schema#","description":"Common structure REPO-A cross-repo corpus fixtures validate against. `kind` pins the algorithm to repo-corpus. `manifest` holds a pseudonymous RepoCorpusManifestV1-shaped object (repos/overlaps/counts only — never payload content). `expected` pins the reader-route posture: manifest_written and whether any cross-repo overlap is claimed. REPO-A-001 valid 3-repo full-consent corpus with a recorded overlap; REPO-A-002 single-repo corpus with empty overlap; REPO-A-003 flag-off (no manifest written, route off).","properties":{"assertion":{"type":"string"},"expected":{"properties":{"manifest_written":{"type":"boolean"},"overlap_count":{"type":"integer"},"route_status":{"enum":["live","off"],"type":"string"}},"required":["manifest_written","route_status"],"type":"object"},"flag_off":{"type":"boolean"},"id":{"type":"string"},"kind":{"enum":["repo-corpus"],"type":"string"},"manifest":{"properties":{"datasetVersion":{"type":"string"},"effectiveSeq":{"type":"integer"},"overlaps":{"items":{"properties":{"repoA":{"type":"string"},"repoB":{"type":"string"},"sharedIds":{"items":{"type":"string"},"type":"array"},"sharedSessions":{"type":"integer"}},"required":["repoA","repoB","sharedSessions","sharedIds"],"type":"object"},"type":"array"},"ownerPseudonym":{"type":"string"},"repos":{"items":{"properties":{"digest":{"type":"string"},"events":{"type":"integer"},"repoPseudonym":{"type":"string"},"sessionIds":{"items":{"type":"string"},"type":"array"},"sessions":{"type":"integer"}},"required":["repoPseudonym","sessions","sessionIds","events","digest"],"type":"object"},"type":"array"},"schema":{"enum":["repo-corpus-manifest-v1"],"type":"string"},"totalEvents":{"type":"integer"}},"required":["schema","ownerPseudonym","datasetVersion","effectiveSeq","totalEvents","repos","overlaps"],"type":"object"},"producer":{"type":"string"},"schema":{"type":"string"}},"required":["id","producer","assertion","kind","schema","expected"],"title":"REPO-A cross-repo corpus fixture envelope","type":"object"}
