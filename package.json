{
  "name": "pi-mega-compact",
  "version": "0.20.70",
  "description": "Layered, local, vector-backed context compressor for pi — supersede/collapse/cluster compaction with deduped inline recall.",
  "type": "module",
  "license": "BSD-3-Clause",
  "author": "TheArchitectit",
  "homepage": "https://github.com/TheArchitectit/pi-mega-compact",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheArchitectit/pi-mega-compact.git"
  },
  "keywords": [
    "pi-extension",
    "pi-coding-agent",
    "openclaw-plugin",
    "context-compaction",
    "auto-compact",
    "vector-store",
    "trident"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "files": [
    "dist",
    "extensions",
    "extensions/dashboard-client/dist",
    "src",
    "assets/vector-cortex/encoder-v1",
    "README.md",
    "LICENSE",
    "!dist/**/*.test.js",
    "!dist/**/*.test.js.map",
    "!**/*.test.ts"
  ],
  "pi": {
    "extensions": [
      "./extensions/mega-compact.ts"
    ]
  },
  "openclaw": {
    "plugin": "./extensions/openclaw-mega-compact.ts",
    "manifest": "./openclaw.plugin.json",
    "compactionProvider": "mega-compact"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.json",
    "postbuild": "node scripts/vector-cortex-publish-acceptance.mjs",
    "build:dashboard": "cd extensions/dashboard-client && npx vite build",
    "test:dashboard-smoke": "node scripts/dashboard-tab-smoke.mjs",
    "lint": "tsc --noEmit && node scripts/guardrails-scan.mjs && node scripts/semantic-scan.mjs && node scripts/stub-scan.mjs --fail-on-unregistered && node scripts/mock-scan.mjs --fail-on-unregistered",
    "test": "npm run build && node scripts/run-tests.mjs",
    "guardrails": "python3 scripts/regression_check.py --all || node scripts/guardrails-scan.mjs || node scripts/semantic-scan.mjs",
    "precommit": "bash .claude/hooks/pre-commit.sh",
    "prepublishOnly": "npm run build && npm run build:dashboard",
    "postinstall": "npm rebuild @mongodb-js/zstd || true"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": ">=0.80",
    "openclaw": ">=0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "playwright": "^1.60.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@electric-sql/pglite-pgvector": "^0.0.5",
    "@mongodb-js/zstd": "^7.0.0",
    "onnxruntime-web": "^1.26.0-dev.20260416-b7804b056c"
  },
  "allowScripts": {
    "@mongodb-js/zstd@7.0.0": true
  }
}
